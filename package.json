{
  "name": "slapjam-ai-2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite --host --port 5301",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "oxlint src test scripts",
    "lint:sim": "ritmo-devtools lint src/lint.ts",
    "test": "node --test \"test/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:sim && pnpm test",
    "shots": "node scripts/shots.ts"
  },
  "dependencies": {
    "@typeonce/ritmo": "0.19.1",
    "@typeonce/ritmo-browser": "0.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typeonce/oxlint-plugin-ritmo": "0.19.1",
    "@typeonce/ritmo-devtools": "0.19.1",
    "@types/node": "25.5.0",
    "oxlint": "^1.90.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
