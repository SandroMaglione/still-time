{
  "name": "still-time",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "art": "node scripts/art.mjs && node scripts/environment.mjs",
    "art:environment": "node scripts/environment.mjs",
    "audio": "node scripts/audio.mjs",
    "icons": "node scripts/icons.ts",
    "dev": "vite --host --port 5301",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "oxlint src test scripts",
    "lint:sim": "ritmo-devtools lint src/lint.ts",
    "test": "node --test \"test/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:sim && pnpm test",
    "shots": "node scripts/shots.ts",
    "shots:art": "node scripts/art-shots.ts",
    "record:fx": "node scripts/fx-record.ts",
    "perf": "node scripts/perf.ts",
    "package": "pnpm build && mkdir -p output && rm -f output/still-time-itch.zip && cd dist && zip -qr ../output/still-time-itch.zip . && cd .. && ls -la output/still-time-itch.zip"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.4",
    "@typeonce/ritmo": "0.19.1",
    "@typeonce/ritmo-browser": "0.19.1",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@typeonce/oxlint-plugin-ritmo": "0.19.1",
    "@typeonce/ritmo-devtools": "0.19.1",
    "@typeonce/ritmo-tools": "0.19.1",
    "@types/node": "25.5.0",
    "oxlint": "^1.90.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
